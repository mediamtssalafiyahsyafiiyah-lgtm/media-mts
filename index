        function populateFilterKelasOptions() {
            const selectKelas = document.getElementById('filter-kelas');
            selectKelas.innerHTML = '<option value="semua">Semua Kelas</option>';
            const kelases = [...new Set(dataSiswa.map(s => s.kelas))];
            kelases.forEach(k => {
                selectKelas.innerHTML += `<option value="${k}">${k}</option>`;
            });
        }

        function filterDataAbsensi() {
            const periode = document.getElementById('filter-periode').value;
            const filterKelas = document.getElementById('filter-kelas').value;
            const filterKw = document.getElementById('filter-keyword').value.toLowerCase().trim();

            return dataAbsensi.filter(item => {
                // Filter Periode
                let passPeriode = false;
                if (periode === 'harian') {
                    const tgl = document.getElementById('filter-tanggal-harian').value;
                    passPeriode = item.tanggal === tgl;
                } else if (periode === 'mingguan') {
                    const tglMulai = document.getElementById('filter-tgl-mulai').value;
                    const tglSelesai = document.getElementById('filter-tgl-selesai').value;
                    passPeriode = item.tanggal >= tglMulai && item.tanggal <= tglSelesai;
                } else if (periode === 'bulanan') {
                    const bln = document.getElementById('filter-bulan').value;
                    const thn = document.getElementById('filter-tahun-bulan').value;
                    passPeriode = item.tanggal.startsWith(`${thn}-${bln}`);
                } else if (periode === 'tahunan') {
                    const thn = document.getElementById('filter-tahun').value;
                    passPeriode = item.tanggal.startsWith(`${thn}-`);
                }

                // Filter Kelas
                let passKelas = (filterKelas === 'semua') || (item.kelas === filterKelas);

                // Filter Keyword
                let passKw = !filterKw || item.nama.toLowerCase().includes(filterKw) || item.nis.toLowerCase().includes(filterKw);

                return passPeriode && passKelas && passKw;
            });
        }

        function renderRekapDanMatriks() {
            const filteredData = filterDataAbsensi();
            const tbodyRekap = document.getElementById('tabel-rekap-absensi');
            tbodyRekap.innerHTML = '';

            filteredData.forEach(r => {
                tbodyRekap.innerHTML += `
                    <tr class="border-b">
                        <td class="p-3 border font-mono text-xs">${r.tanggal}</td>
                        <td class="p-3 border font-mono font-bold">${r.nis}</td>
                        <td class="p-3 border font-semibold">${r.nama}</td>
                        <td class="p-3 border">${r.kelas}</td>
                        <td class="p-3 border text-green-700 font-mono font-bold">${r.jamDatang}</td>
                        <td class="p-3 border text-blue-700 font-mono font-bold">${r.jamPulang}</td>
                        <td class="p-3 border"><span class="px-2 py-1 rounded text-xs font-bold ${getStatusColor(r.status)}">${r.status}</span></td>
                    </tr>
                `;
            });

            // Calculate Matriks Statistik Kelas berdasarkan Filtered Data
            const filterKelas = document.getElementById('filter-kelas').value;
            const matriks = {};

            dataSiswa.forEach(s => {
                if(filterKelas !== 'semua' && s.kelas !== filterKelas) return;

                if(!matriks[s.kelas]) {
                    matriks[s.kelas] = { total: 0, hadir: 0, terlambat: 0, izinsakit: 0, alpa: 0 };
                }
                matriks[s.kelas].total++;

                const recs = filteredData.filter(a => a.nis === s.nis);
                recs.forEach(a => {
                    if(a.status === 'Hadir') matriks[s.kelas].hadir++;
                    else if(a.status === 'Terlambat') matriks[s.kelas].terlambat++;
                    else if(a.status === 'Izin' || a.status === 'Sakit') matriks[s.kelas].izinsakit++;
                    else if(a.status === 'Alpa') matriks[s.kelas].alpa++;
                });
            });

            const tbodyMatriks = document.getElementById('tabel-matriks-kelas');
            tbodyMatriks.innerHTML = '';
            for (let kelas in matriks) {
                let m = matriks[kelas];
                let totalSesi = m.hadir + m.terlambat + m.izinsakit + m.alpa;
                let persen = totalSesi > 0 ? (((m.hadir + m.terlambat) / totalSesi) * 100).toFixed(1) : 0;

                tbodyMatriks.innerHTML += `
                    <tr class="border-b">
                        <td class="p-3 border font-bold">${kelas}</td>
                        <td class="p-3 border">${m.total}</td>
                        <td class="p-3 border text-green-700 font-bold">${m.hadir}</td>
                        <td class="p-3 border text-yellow-600 font-bold">${m.terlambat}</td>
                        <td class="p-3 border text-blue-700 font-bold">${m.izinsakit}</td>
                        <td class="p-3 border text-red-700 font-bold">${m.alpa}</td>
                        <td class="p-3 border font-bold text-purple-700">${persen}%</td>
                    </tr>
                `;
            }
        }

        function getStatusColor(status) {
            switch(status) {
                case 'Hadir': return 'bg-green-100 text-green-800';
                case 'Terlambat': return 'bg-yellow-100 text-yellow-800';
                case 'Izin': return 'bg-blue-100 text-blue-800';
                case 'Sakit': return 'bg-blue-100 text-blue-800';
                case 'Alpa': return 'bg-red-100 text-red-800';
                default: return 'bg-gray-100 text-gray-800';
            }
        }

        function exportRekapExcel() {
            const filteredData = filterDataAbsensi();
            if(filteredData.length === 0) return alert("Tidak ada data untuk diexport!");

            const periode = document.getElementById('filter-periode').value;
            const ws = XLSX.utils.json_to_sheet(filteredData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Rekap Absensi");
            XLSX.writeFile(wb, `Laporan_Absensi_${periode.toUpperCase()}.xlsx`);
        }
    </script>
</body>
</html>
