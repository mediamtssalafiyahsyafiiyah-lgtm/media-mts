        function simpanEditSiswa(e) {
            e.preventDefault();
            const nis = document.getElementById('edit-nis').value;
            const namaBaru = document.getElementById('edit-nama').value.trim();
            const kelasBaru = document.getElementById('edit-kelas').value.trim();
            const waBaru = document.getElementById('edit-wa').value.trim();

            const idx = dataSiswa.findIndex(s => s.nis === nis);
            if (idx !== -1) {
                // Update data siswa
                dataSiswa[idx].nama = namaBaru;
                dataSiswa[idx].kelas = kelasBaru;
                dataSiswa[idx].noWa = waBaru;
                
                // Update histori absensi jika ada
                dataAbsensi.forEach(a => {
                    if (a.nis === nis) {
                        a.nama = namaBaru;
                        a.kelas = kelasBaru;
                    }
                });

                localStorage.setItem('absensi_siswa', JSON.stringify(dataSiswa));
                localStorage.setItem('absensi_rekap', JSON.stringify(dataAbsensi));

                renderTabelSiswa();
                populateFilterKelasOptions();
                renderRekapDanMatriks();
                tutupModalEdit();
                alert("Data siswa berhasil diperbarui!");
            }
        }

