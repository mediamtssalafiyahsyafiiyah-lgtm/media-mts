        // Hardware USB/Bluetooth Scanner Focus Lock Engine
        function initHardwareScanner() {
            const hwInput = document.getElementById('input-hardware-scanner');
            
            // Auto-focus lock logic
            document.addEventListener('click', function(e) {
                if(!['INPUT', 'TEXTAREA', 'SELECT'].includes(e.target.tagName)) {
                    hwInput.focus();
                }
            });

            hwInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    let scannedNis = hwInput.value.trim();
                    if(scannedNis) {
                        prosesAbsensi(scannedNis);
                        hwInput.value = '';
                    }
                }
            });
