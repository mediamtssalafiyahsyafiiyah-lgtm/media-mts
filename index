        // Excel Handlers
        function importExcel() {
            const fileInput = document.getElementById('excel-file');
            const file = fileInput.files[0];
            if (!file) return alert("Pilih file excel!");

            const reader = new FileReader();
            reader.onload = function(e) {
                const data = new Uint8Array(e.target.result);
                const workbook = XLSX.read(data, { type: 'array' });
                const json = XLSX.utils.sheet_to_json(workbook.Sheets[workbook.SheetNames[0]]);

                json.forEach(row => {
                    if (row.NIS && !dataSiswa.some(s => s.nis == row.NIS)) {
                        dataSiswa.push({
                            nis: String(row.NIS),
                            nama: row.Nama || '',
                            kelas: row.Kelas || '',
                            noWa: String(row.NoWA || '')
                        });
                    }
                });
                localStorage.setItem('absensi_siswa', JSON.stringify(dataSiswa));
                renderTabelSiswa();
                populateFilterKelasOptions();
                alert("Import Data Siswa Berhasil!");
            };
            reader.readAsArrayBuffer(file);
        }

