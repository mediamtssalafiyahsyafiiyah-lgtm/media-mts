<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi Absensi Digital QR Code</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- HTML5 QRCode Scanner -->
    <script src="https://unpkg.com/html5-qrcode"></script>
    <!-- QRCode JS Generator -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- XLSX (SheetJS) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body class="bg-gray-100 font-sans antialiased">

    <!-- Header Navigation -->
    <header class="bg-blue-700 text-white shadow-lg sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3 flex justify-between items-center">
            <h1 class="text-xl font-bold tracking-wide" id="nav-nama-lembaga">Absensi Digital Sekolah</h1>
            <nav class="flex space-x-1 md:space-x-2 text-xs md:text-sm font-medium">
                <button onclick="showPage('beranda')" class="px-3 py-2 rounded hover:bg-blue-600 transition">Beranda & Scanner</button>
                <button onclick="showPage('data-siswa')" class="px-3 py-2 rounded hover:bg-blue-600 transition">Data Siswa</button>
                <button onclick="showPage('cetak-qr')" class="px-3 py-2 rounded hover:bg-blue-600 transition">Cetak QR Masal</button>
                <button onclick="showPage('rekap')" class="px-3 py-2 rounded hover:bg-blue-600 transition">Laporan & Rekap</button>
            </nav>
        </div>
    </header>

    <main class="container mx-auto px-4 py-6">

        <!-- ================= HALAMAN BERANDA & ALAT SCANNER UTAMA ================= -->
        <section id="page-beranda" class="space-y-6">
            <!-- Header Identitas Lembaga & Jam Otomatis -->
            <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-blue-600 flex justify-between items-center flex-wrap gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-gray-800" id="identitas-nama">SMA NEGERI 1 DIGITAL</h2>
                    <p class="text-gray-600" id="identitas-alamat">Jl. Pendidikan No. 123, Kota Digital</p>
                </div>
                <div class="text-right">
                    <div id="jam-otomatis" class="text-3xl font-extrabold text-blue-700 font-mono">00:00:00</div>
                    <div id="tanggal-otomatis" class="text-sm font-medium text-gray-500">Senin, 1 Januari 2026</div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Main Scanner Section -->
                <div class="md:col-span-2 space-y-6">
                    <div class="bg-white p-6 rounded-lg shadow-md border-2 border-blue-100">
                        <div class="flex justify-between items-center mb-4 flex-wrap gap-2">
                            <h3 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                                <span>📟</span> ALAT SCANNER FISIK (UTAMA)
                            </h3>
                            <div class="flex space-x-2">
                                <button id="btn-mode-masuk" onclick="setScanMode('Masuk')" class="px-4 py-2 rounded-lg bg-green-600 text-white font-semibold shadow">Absen Datang</button>
                                <button id="btn-mode-pulang" onclick="setScanMode('Pulang')" class="px-4 py-2 rounded-lg bg-gray-200 text-gray-700 font-semibold shadow">Absen Pulang</button>
                            </div>
                        </div>

                        <!-- Primary Input: Alat Scanner USB / Bluetooth / Wireless -->
                        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 p-5 rounded-xl border-2 border-blue-400 mb-4 shadow-inner">
                            <div class="flex items-center justify-between mb-2">
                                <label class="block text-xs font-black text-blue-900 tracking-wider">Arahkan Scanner Barcode / QR Code ke Sini:</label>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 animate-pulse">
                                    ● Scanner Ready
                                </span>
                            </div>
                            <input type="text" id="input-hardware-scanner" placeholder="Scan Barcode Kartu Siswa..." class="w-full p-3 border-2 border-blue-500 rounded-lg text-lg bg-white font-mono font-bold text-gray-800 focus:outline-none focus:ring-4 focus:ring-blue-300 transition" autofocus>
                            <p class="text-[11px] text-gray-500 mt-2">💡 *Fitur Auto-Lock Focus aktif. Tekan sembarang area untuk kembali memindai otomatis.*</p>
                        </div>

                        <!-- Optional Camera Scanner (Accordion / Toggle) -->
                        <div class="mb-4">
                            <button onclick="toggleKamera()" class="text-xs text-blue-600 font-bold hover:underline flex items-center gap-1">
                                📷 <span id="label-toggle-kamera">Buka Camera Scanner (Opsional)</span>
                            </button>
                            <div id="container-kamera" class="hidden mt-3">
                                <div id="reader" class="w-full rounded-lg overflow-hidden border border-gray-300"></div>
                            </div>
                        </div>

                        <!-- Status Log Scan Terakhir -->
                        <div class="mt-4 border-t pt-4">
                            <h4 class="text-sm font-bold text-gray-700 mb-2">Notifikasi Scan Terakhir</h4>
                            <div id="box-notif-terakhir" class="p-4 rounded-lg bg-gray-100 text-center text-sm font-medium text-gray-500 border">
                                Belum Ada Aktivitas Scan
                            </div>
                        </div>

                        <!-- Input Manual Status (Izin, Sakit, Alpa) -->
                        <div class="mt-6 border-t pt-4">
                            <h4 class="text-sm font-bold text-gray-600 mb-2">Input Status Absensi Manual (Izin / Sakit / Alpa)</h4>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-2 mb-2">
                                <input type="text" id="manual-nis" placeholder="Masukkan NIS Siswa" class="p-2 border rounded text-sm w-full">
                                <select id="manual-status" class="p-2 border rounded text-sm w-full">
                                    <option value="Hadir">Hadir</option>
                                    <option value="Izin">Izin</option>
                                    <option value="Sakit">Sakit</option>
                                    <option value="Alpa">Alpa</option>
                                </select>
                                <button onclick="submitManualAbsen()" class="bg-blue-600 text-white px-4 py-2 rounded text-sm font-bold hover:bg-blue-700">Simpan Absen</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PENGATURAN LENGKAP -->
                <div class="bg-white p-6 rounded-lg shadow-md space-y-6">
                    <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
                        <h4 class="text-sm font-bold text-blue-800 mb-1">Status Mode Aktif:</h4>
                        <p id="label-mode-aktif" class="text-xl font-black text-green-600">ABSEN DATANG</p>
                    </div>

                    <h3 class="text-lg font-bold text-gray-800 border-b pb-2">Pengaturan System</h3>

                    <!-- Identitas & Jam -->
                    <div class="space-y-3">
                        <h4 class="font-bold text-gray-700 text-sm">1. Identitas & Jam Operasional</h4>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Nama Lembaga</label>
                            <input type="text" id="setup-nama-lembaga" class="w-full p-2 border rounded text-sm">
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Alamat Sekolah</label>
                            <input type="text" id="setup-alamat-lembaga" class="w-full p-2 border rounded text-sm">
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div>
                                <label class="text-xs font-semibold text-gray-500">Jam Hadir</label>
                                <input type="time" id="set-jam-masuk" class="w-full p-1 border rounded text-xs">
                            </div>
                            <div>
                                <label class="text-xs font-semibold text-gray-500">Terlambat</label>
                                <input type="time" id="set-jam-terlambat" class="w-full p-1 border rounded text-xs">
                            </div>
                            <div>
                                <label class="text-xs font-semibold text-gray-500">Pulang</label>
                                <input type="time" id="set-jam-pulang" class="w-full p-1 border rounded text-xs">
                            </div>
                        </div>
                    </div>

                    <!-- WA Gateway Config -->
                    <div class="space-y-3 border-t pt-4">
                        <h4 class="font-bold text-gray-700 text-sm">2. WA Gateway & Notifikasi</h4>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Mode Pengiriman WA</label>
                            <select id="wa-mode" class="w-full p-2 border rounded text-sm">
                                <option value="direct">Direct WhatsApp Web/App</option>
                                <option value="api">API Server Gateway (Silent Background)</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Kirim Notifikasi Untuk Status:</label>
                            <select id="wa-filter" class="w-full p-2 border rounded text-sm">
                                <option value="all">Semua Status Absensi</option>
                                <option value="hadir">Hanya Tepat Waktu & Pulang</option>
                                <option value="terlambat">Hanya Terlambat & Alpa</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">URL Endpoint API (Jika Mode API)</label>
                            <input type="text" id="wa-api-url" placeholder="https://api.fonnte.com/send" class="w-full p-2 border rounded text-sm">
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">API Key / Token</label>
                            <input type="text" id="wa-api-key" placeholder="Masukkan Token API" class="w-full p-2 border rounded text-sm">
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Format Pesan Datang</label>
                            <textarea id="template-wa-datang" rows="2" class="w-full p-2 border rounded text-xs mt-1"></textarea>
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-gray-500">Format Pesan Pulang</label>
                            <textarea id="template-wa-pulang" rows="2" class="w-full p-2 border rounded text-xs mt-1"></textarea>
                        </div>
                    </div>

                    <!-- Suara Config -->
                    <div class="space-y-2 border-t pt-4">
                        <h4 class="font-bold text-gray-700 text-sm">3. Pengaturan Suara</h4>
                        <div class="flex items-center space-x-2">
                            <input type="checkbox" id="suara-aktif" checked class="w-4 h-4 text-blue-600">
                            <label for="suara-aktif" class="text-xs font-semibold text-gray-700">Aktifkan Suara Notifikasi Nama Siswa</label>
                        </div>
                    </div>

                    <button onclick="simpanPengaturanUmum()" class="w-full bg-blue-600 text-white py-2 rounded text-sm font-bold hover:bg-blue-700 shadow">Simpan Seluruh Pengaturan</button>
                </div>
            </div>
        </section>

        <!-- ================= HALAMAN: DATA SISWA ================= -->
        <section id="page-data-siswa" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Pengelolaan Data Siswa</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <!-- Form Input Manual -->
                    <div class="p-4 border rounded-lg bg-gray-50">
                        <h4 class="font-bold text-gray-700 mb-3">Input Siswa Manual</h4>
                        <form id="form-tambah-siswa" onsubmit="tambahSiswaManual(event)" class="space-y-3">
                            <input type="text" id="input-nis" placeholder="NIS / ID Siswa" required class="w-full p-2 border rounded text-sm">
                            <input type="text" id="input-nama" placeholder="Nama Lengkap Siswa" required class="w-full p-2 border rounded text-sm">
                            <input type="text" id="input-kelas" placeholder="Kelas (contoh: X IPA 1)" required class="w-full p-2 border rounded text-sm">
                            <input type="text" id="input-wa" placeholder="Nomor WA Orang Tua (contoh: 628123456789)" required class="w-full p-2 border rounded text-sm">
                            <button type="submit" class="w-full bg-green-600 text-white py-2 rounded text-sm font-bold hover:bg-green-700">Tambah Siswa</button>
                        </form>
                    </div>

                    <!-- Upload Template Excel -->
                    <div class="p-4 border rounded-lg bg-gray-50">
                        <h4 class="font-bold text-gray-700 mb-3">Import Data Excel</h4>
                        <p class="text-xs text-gray-500 mb-3">Format Kolom Excel: <b>NIS | Nama | Kelas | NoWA</b></p>
                        <input type="file" id="excel-file" accept=".xlsx, .xls" class="block w-full text-sm text-gray-500 border rounded p-2 mb-3">
                        <div class="flex space-x-2">
                            <button onclick="importExcel()" class="bg-blue-600 text-white px-4 py-2 rounded text-sm font-bold hover:bg-blue-700">Import Excel</button>
                            <button onclick="downloadTemplate()" class="bg-gray-600 text-white px-4 py-2 rounded text-sm font-bold hover:bg-gray-700">Download Template</button>
                        </div>
                    </div>
                </div>

                <h4 class="font-bold text-gray-700 mb-2">Daftar Siswa Terdaftar</h4>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border">
                        <thead class="bg-gray-200 text-gray-700 uppercase text-xs">
                            <tr>
                                <th class="p-3 border">NIS</th>
                                <th class="p-3 border">Nama Siswa</th>
                                <th class="p-3 border">Kelas</th>
                                <th class="p-3 border">No. WA Orang Tua</th>
                                <th class="p-3 border text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody id="tabel-siswa"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- MODAL / POPUP EDIT SISWA -->
        <div id="modal-edit-siswa" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex justify-center items-center p-4">
            <div class="bg-white rounded-lg shadow-xl w-full max-w-md p-6 relative animate-fade-in">
                <div class="flex justify-between items-center border-b pb-3 mb-4">
                    <h3 class="text-lg font-bold text-gray-800">Edit Data Siswa</h3>
                    <button onclick="tutupModalEdit()" class="text-gray-400 hover:text-gray-600 text-xl font-bold">&times;</button>
                </div>
                <form id="form-edit-siswa" onsubmit="simpanEditSiswa(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">NIS (Tidak Dapat Diubah)</label>
                        <input type="text" id="edit-nis" readonly class="w-full p-2 border rounded text-sm bg-gray-100 font-bold text-gray-600 cursor-not-allowed">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Nama Lengkap Siswa</label>
                        <input type="text" id="edit-nama" required class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">Kelas</label>
                        <input type="text" id="edit-kelas" required class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-700 mb-1">No. WhatsApp Orang Tua</label>
                        <input type="text" id="edit-wa" required class="w-full p-2 border rounded text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                    </div>
                    <div class="flex justify-end space-x-2 pt-3 border-t">
                        <button type="button" onclick="tutupModalEdit()" class="px-4 py-2 bg-gray-300 text-gray-700 rounded text-sm font-semibold hover:bg-gray-400">Batal</button>
                        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded text-sm font-semibold hover:bg-blue-700 shadow">Simpan Perubahan</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- ================= HALAMAN: CETAK QR BARCODE MASAL ================= -->
        <section id="page-cetak-qr" class="hidden space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-md">
                <div class="flex justify-between items-center mb-4">
                    <div>
                        <h3 class="text-xl font-bold text-gray-800">Cetak QR Barcode Masal</h3>
                        <p class="text-sm text-gray-500">Cetak kartu barcode siswa untuk absensi otomatis.</p>
                    </div>
                    <button onclick="prosesCetakQR()" class="bg-purple-600 text-white px-6 py-2 rounded text-sm font-bold hover:bg-purple-700 shadow">Print / Cetak Semua Kartu</button>
                </div>
                
                <div id="preview-qr-container" class="grid grid-cols-2 md:grid-cols-4 gap-4 p-4 border rounded bg-gray-50">
                    <!-- Dynamic Cards Preview -->
                </div>
            </div>
        </section>

        <div id="print-area" class="hidden"></div>

        <!-- ================= HALAMAN: LAPORAN REKAP HARIAN, MINGGUAN, BULANAN, TAHUNAN ================= -->
        <section id="page-rekap" class="hidden space-y-6">
            <!-- Filter Laporan Komprehensif -->
            <div class="bg-white p-6 rounded-lg shadow-md space-y-4">
                <h3 class="text-xl font-bold text-gray-800 border-b pb-2">Filter & Laporan Rekap Absensi</h3>
                
                <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
                    <div>
                        <label class="text-xs font-bold text-gray-600 block mb-1">Periode Laporan</label>
                        <select id="filter-periode" onchange="toggleFilterPeriode()" class="w-full p-2 border rounded text-sm bg-gray-50 font-semibold">
                            <option value="harian">Harian (Per Tanggal)</option>
                            <option value="mingguan">Mingguan (Rentang Tanggal)</option>
                            <option value="bulanan">Bulanan (Bulan & Tahun)</option>
                            <option value="tahunan">Tahunan (Per Tahun)</option>
                        </select>
                    </div>

                    <!-- Dynamic Input Sesuai Periode -->
                    <div id="box-filter-harian">
                        <label class="text-xs font-bold text-gray-600 block mb-1">Tanggal</label>
                        <input type="date" id="filter-tanggal-harian" class="w-full p-2 border rounded text-sm">
                    </div>

                    <div id="box-filter-mingguan" class="hidden col-span-2 flex gap-2">
                        <div class="w-1/2">
                            <label class="text-xs font-bold text-gray-600 block mb-1">Dari Tanggal</label>
                            <input type="date" id="filter-tgl-mulai" class="w-full p-2 border rounded text-sm">
                        </div>
                        <div class="w-1/2">
                            <label class="text-xs font-bold text-gray-600 block mb-1">Sampai Tanggal</label>
                            <input type="date" id="filter-tgl-selesai" class="w-full p-2 border rounded text-sm">
                        </div>
                    </div>

                    <div id="box-filter-bulanan" class="hidden flex gap-2">
                        <div class="w-1/2">
                            <label class="text-xs font-bold text-gray-600 block mb-1">Bulan</label>
                            <select id="filter-bulan" class="w-full p-2 border rounded text-sm">
                                <option value="01">Januari</option>
                                <option value="02">Februari</option>
                                <option value="03">Maret</option>
                                <option value="04">April</option>
                                <option value="05">Mei</option>
                                <option value="06">Juni</option>
                                <option value="07">Juli</option>
                                <option value="08">Agustus</option>
                                <option value="09">September</option>
                                <option value="10">Oktober</option>
                                <option value="11">November</option>
                                <option value="12">Desember</option>
                            </select>
                        </div>
                        <div class="w-1/2">
                            <label class="text-xs font-bold text-gray-600 block mb-1">Tahun</label>
                            <input type="number" id="filter-tahun-bulan" value="2026" class="w-full p-2 border rounded text-sm">
                        </div>
                    </div>

                    <div id="box-filter-tahunan" class="hidden">
                        <label class="text-xs font-bold text-gray-600 block mb-1">Tahun</label>
                        <input type="number" id="filter-tahun" value="2026" class="w-full p-2 border rounded text-sm">
                    </div>

                    <div>
                        <label class="text-xs font-bold text-gray-600 block mb-1">Filter Kelas</label>
                        <select id="filter-kelas" class="w-full p-2 border rounded text-sm">
                            <option value="semua">Semua Kelas</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-bold text-gray-600 block mb-1">Cari Nama / NIS</label>
                        <input type="text" id="filter-keyword" placeholder="Nama / NIS..." class="w-full p-2 border rounded text-sm">
                    </div>
                </div>

                <div class="flex space-x-2 pt-2">
                    <button onclick="renderRekapDanMatriks()" class="bg-blue-600 text-white px-5 py-2 rounded text-sm font-bold hover:bg-blue-700">Terapkan Filter</button>
                    <button onclick="exportRekapExcel()" class="bg-green-600 text-white px-5 py-2 rounded text-sm font-bold hover:bg-green-700">Export Laporan ke Excel</button>
                </div>
            </div>

            <!-- Ringkasan Matriks Statistik Kelas -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Statistik Matriks Kehadiran Siswa</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border">
                        <thead class="bg-blue-600 text-white uppercase text-xs">
                            <tr>
                                <th class="p-3 border">Kelas</th>
                                <th class="p-3 border">Total Siswa</th>
                                <th class="p-3 border bg-green-700">Hadir (Tepat Waktu)</th>
                                <th class="p-3 border bg-yellow-600">Terlambat</th>
                                <th class="p-3 border bg-blue-800">Izin / Sakit</th>
                                <th class="p-3 border bg-red-700">Alpa</th>
                                <th class="p-3 border bg-purple-700">Persentase Kehadiran</th>
                            </tr>
                        </thead>
                        <tbody id="tabel-matriks-kelas"></tbody>
                    </table>
                </div>
            </div>

            <!-- Tabel Detail Laporan Rekap Absensi -->
            <div class="bg-white p-6 rounded-lg shadow-md">
                <h3 class="text-xl font-bold text-gray-800 mb-4">Rincian Data Absensi Siswa</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm text-left border">
                        <thead class="bg-gray-100 text-gray-700 uppercase text-xs">
                            <tr>
                                <th class="p-3 border">Tanggal</th>
                                <th class="p-3 border">NIS</th>
                                <th class="p-3 border">Nama</th>
                                <th class="p-3 border">Kelas</th>
                                <th class="p-3 border">Waktu Datang</th>
                                <th class="p-3 border">Waktu Pulang</th>
                                <th class="p-3 border">Status</th>
                            </tr>
                        </thead>
                        <tbody id="tabel-rekap-absensi"></tbody>
                    </table>
                </div>
            </div>
        </section>

    </main>

    <!-- JavaScript Core Engine -->
    <script>
        let dataSiswa = JSON.parse(localStorage.getItem('absensi_siswa')) || [];
        let dataAbsensi = JSON.parse(localStorage.getItem('absensi_rekap')) || [];
        let config = JSON.parse(localStorage.getItem('absensi_config')) || {
            namaLembaga: "SMA NEGERI 1 DIGITAL",
            alamatLembaga: "Jl. Pendidikan No. 123, Kota Digital",
            jamMasuk: "07:00",
            jamTerlambat: "07:15",
            jamPulang: "15:00",
            waMode: "direct",
            waFilter: "all",
            waApiUrl: "",
            waApiKey: "",
