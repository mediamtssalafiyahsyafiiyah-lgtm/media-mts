        // Attendance Processing Engine
        function prosesAbsensi(nis, statusManual = null) {
            const siswa = dataSiswa.find(s => s.nis === nis);
            const boxNotif = document.getElementById('box-notif-terakhir');

            if (!siswa) {
                boxNotif.innerHTML = `<span class="text-red-600 font-bold">NIS ${nis} Tidak Terdaftar!</span>`;
                ucapkansuara("Data siswa tidak ditemukan");
                return;
            }

            const today = new Date().toISOString().split('T')[0];
            const timeNow = new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });

            let recordIndex = dataAbsensi.findIndex(a => a.nis === nis && a.tanggal === today);

            if (scanMode === 'Masuk' && !statusManual) {
                if (recordIndex >= 0 && dataAbsensi[recordIndex].jamDatang !== '-') {
                    boxNotif.innerHTML = `<span class="text-yellow-600 font-bold">PERINGATAN: ${siswa.nama} Sudah Absen Datang!</span>`;
                    ucapkansuara(`Anda sudah terdaftar, ${siswa.nama}`);
                    return;
                }

                let status = (timeNow > config.jamTerlambat) ? 'Terlambat' : 'Hadir';

                if (recordIndex >= 0) {
                    dataAbsensi[recordIndex].jamDatang = timeNow;
                    dataAbsensi[recordIndex].status = status;
                } else {
                    dataAbsensi.push({
                        tanggal: today,
                        nis: siswa.nis,
                        nama: siswa.nama,
                        kelas: siswa.kelas,
                        jamDatang: timeNow,
                        jamPulang: '-',
                        status: status
                    });
                }
                
                boxNotif.innerHTML = `<span class="text-green-600 font-bold">BERHASIL: Absen Datang ${siswa.nama} (${timeNow})</span>`;
                ucapkansuara(`Selamat datang ${siswa.nama}`);
                kirimNotifikasiWA(siswa, timeNow, status, 'datang');

            } else if (scanMode === 'Pulang' && !statusManual) {
                if (recordIndex >= 0 && dataAbsensi[recordIndex].jamPulang !== '-') {
                    boxNotif.innerHTML = `<span class="text-yellow-600 font-bold">PERINGATAN: ${siswa.nama} Sudah Absen Pulang!</span>`;
                    ucapkansuara(`Anda sudah terdaftar, ${siswa.nama}`);
                    return;
                }

                if (recordIndex >= 0) {
                    dataAbsensi[recordIndex].jamPulang = timeNow;
                } else {
                    dataAbsensi.push({
                        tanggal: today,
                        nis: siswa.nis,
                        nama: siswa.nama,
                        kelas: siswa.kelas,
                        jamDatang: '-',
                        jamPulang: timeNow,
                        status: 'Hadir'
                    });
                }

                boxNotif.innerHTML = `<span class="text-blue-600 font-bold">BERHASIL: Absen Pulang ${siswa.nama} (${timeNow})</span>`;
                ucapkansuara(`Terima kasih ${siswa.nama}`);
                kirimNotifikasiWA(siswa, timeNow, 'Pulang', 'pulang');

            } else if (statusManual) {
                if (recordIndex >= 0) {
                    dataAbsensi[recordIndex].status = statusManual;
                } else {
                    dataAbsensi.push({
                        tanggal: today,
                        nis: siswa.nis,
                        nama: siswa.nama,
                        kelas: siswa.kelas,
                        jamDatang: '-',
                        jamPulang: '-',
                        status: statusManual
                    });
                }
                boxNotif.innerHTML = `<span class="text-blue-600 font-bold">Status ${siswa.nama} Diubah: ${statusManual}</span>`;
            }

            localStorage.setItem('absensi_rekap', JSON.stringify(dataAbsensi));
            renderRekapDanMatriks();
        }

        function submitManualAbsen() {
            const nis = document.getElementById('manual-nis').value.trim();
            const status = document.getElementById('manual-status').value;
            if(!nis) return alert("Masukkan NIS Siswa!");
            prosesAbsensi(nis, status);
            document.getElementById('manual-nis').value = '';
        }

        // Voice Engine
        function ucapkansuara(teks) {
            if (!config.suaraAktif) return;
            if ('speechSynthesis' in window) {
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(teks);
                utterance.lang = 'id-ID';
                utterance.rate = 0.9;
                window.speechSynthesis.speak(utterance);
            }
        }

        // WA Gateway Notification Dispatcher
        function kirimNotifikasiWA(siswa, jam, status, tipe) {
            if (!siswa.noWa) return;

            if (config.waFilter === 'hadir' && status === 'Terlambat') return;
            if (config.waFilter === 'terlambat' && status === 'Hadir') return;

            let template = (tipe === 'datang') ? config.templateDatang : config.templatePulang;
            let pesan = template.replace('{NAMA}', siswa.nama)
                                .replace('{JAM}', jam)
                                .replace('{STATUS}', status)
                                .replace('{TANGGAL}', new Date().toLocaleDateString('id-ID'));

            if (config.waMode === 'direct') {
                let url = `https://api.whatsapp.com/send?phone=${siswa.noWa}&text=${encodeURIComponent(pesan)}`;
                window.open(url, '_blank');
            } else if (config.waMode === 'api' && config.waApiUrl) {
                fetch(config.waApiUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': config.waApiKey
                    },
                    body: JSON.stringify({ target: siswa.noWa, message: pesan })
                }).catch(err => console.log('WA Dispatch Error:', err));
            }
        }

